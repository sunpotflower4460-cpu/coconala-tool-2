{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mitsumori-desk",
  "version": "0.1.0",
  "identifier": "com.mitsumoridesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "見積・請求書デスク",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "publisher": "",
    "copyright": "",
    "shortDescription": "AIなしでも使える見積・請求書デスクトップアプリ",
    "longDescription": "購入者自身が初回設定し、AIなしでも見積・請求・納品・領収書を作成できる、ローカル完結型の買い切りデスクトップアプリです。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
